      "id": "e4000000-0000-4000-8000-000000000006",
      "name": "Validate input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Solo se permiten las dos colecciones conocidas\nconst body = $('Webhook').first().json.body || {};\nconst collections = { articles: $env.QDRANT_COLLECTION, incidents: $env.QDRANT_INCIDENTS_COLLECTION };\nconst collection = collections[body.collection];\nconst text = typeof body.text === 'string' ? body.text.trim() : '';\nconst threshold = Number(body.threshold);\nconst topK = Number(body.topK);\n\nconst errors = [];\nif (!collection) errors.push('unknown collection');\nif (!text) errors.push('text is blank');\nif (!(threshold >= 0 && threshold <= 1)) errors.push('threshold must be between 0 and 1');\nif (!(Number.isInteger(topK) && topK >= 1 && topK <= 20)) errors.push('topK must be between 1 and 20');\n\nreturn [{ json: { collection, text, threshold, topK, valid: errors.length === 0, validationError: errors.join('; ') } }];"
      }
    },
    {
      "id": "e4000000-0000-4000-8000-000000000008",
      "name": "Valid input?",
      "type": "n8n-nodes-base.if",
