        }
      }
    },
    {
      "id": "e4000000-0000-4000-8000-000000000011",
      "name": "Search Qdrant",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        100
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.QDRANT_URL }}/collections/{{ $('Validate input').first().json.collection }}/points/search",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ vector: $json.data[0].embedding, limit: $('Validate input').first().json.topK, score_threshold: $('Validate input').first().json.threshold, with_payload: false }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "e4000000-0000-4000-8000-000000000012",
      "name": "Respond hits",
