      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ hits: ($json.result || []).map(h => ({ id: h.id, score: Math.round(h.score * 10000) / 10000 })) }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
