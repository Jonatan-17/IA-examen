      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Une cada embedding con su incidente\nconst prepared = $('Prepare incidents').first().json;\nconst data = [...($input.first().json.data || [])].sort((a, b) => a.index - b.index);\nif (data.length !== prepared.active.length) throw new Error(`Expected ${prepared.active.length} embeddings, got ${data.length}`);\nreturn [{ json: { points: prepared.active.map((a, i) => ({ id: a.id, vector: data[i].embedding, payload: a.payload })) } }];"
      }
    },
