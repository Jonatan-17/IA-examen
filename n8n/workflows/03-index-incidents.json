    {
      "id": "e3000000-0000-4000-8000-000000000006",
      "name": "Prepare incidents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Resueltos se indexan; el resto se borra. Point id = incident id.\nconst body = $('Webhook').first().json.body || {};\nconst list = (Array.isArray(body.incidents) ? body.incidents : []).filter(i => Number.isInteger(i.id) && i.id > 0);\n\nconst toText = i => [\n  `Título: ${i.title ?? ''}`,\n  `Categoría: ${i.category ?? ''}`,\n  `Descripción: ${i.description ?? ''}`,\n  `Resolución: ${i.resolution ?? ''}`,\n].join('\\n');\n\nconst active = list.filter(i => i.active === true).map(i => ({ id: i.id, text: toText(i), payload: { incident_id: i.id, title: i.title ?? '' } }));\nconst inactiveIds = list.filter(i => i.active !== true).map(i => i.id);\n\nreturn [{ json: { active, inactiveIds, hasActive: active.length > 0, hasInactive: inactiveIds.length > 0 } }];"
      }
    },
